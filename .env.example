# Copy this to .env (do NOT commit .env) and fill in real values before
# running `docker compose up`.

# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# Pick a strong password for the Postgres user Docker Compose creates.
POSTGRES_PASSWORD=

# Your Oracle VM's public IP address (no domain yet), e.g. 129.146.xxx.xxx
PHX_HOST=
