<header class="sticky top-0 z-10 border-b border-line bg-paper-raised px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between py-3 text-sm">
    <div class="flex items-center gap-2">
      <.link navigate={~p"/"} class="flex items-center gap-1.5 font-extrabold text-ink">
        <span class="text-lg text-copper" aria-hidden="true">⚡</span> Pulse
      </.link>
      <span class="hidden text-ink-soft sm:inline">&middot; Zambia cost-of-living tracker</span>
    </div>
    <div class="flex items-center gap-3 font-semibold leading-6 text-ink sm:gap-4">
      <button
        type="button"
        id="theme-toggle"
        aria-label="Toggle dark mode"
        class="flex h-8 w-8 items-center justify-center rounded-full border border-line text-ink-soft hover:text-copper-strong"
      >
        <.icon name="hero-sun" class="theme-icon-sun h-4 w-4" />
        <.icon name="hero-moon" class="theme-icon-moon h-4 w-4" />
      </button>
      <%!--
        On phones the admin link shrinks to an icon, and the username itself
        is the link to account settings (rather than a separate "Account"
        link beside plain-text username), so a logged-in admin's nav still
        fits on one line at ~360px wide.
      --%>
      <.link
        :if={assigns[:current_user] && @current_user.is_admin}
        navigate={~p"/moderation"}
        aria-label="Moderation"
        title="Moderation"
        class="flex items-center hover:text-copper-strong"
      >
        <.icon name="hero-shield-check" class="h-5 w-5 sm:hidden" />
        <span class="hidden sm:inline">Moderation</span>
      </.link>
      <.link
        :if={assigns[:current_user]}
        navigate={~p"/users/settings"}
        title="Account settings"
        class="flex items-center gap-1.5 hover:text-copper-strong"
      >
        <.icon name="hero-user-circle" class="h-5 w-5 flex-none" />
        <span class="max-w-[8rem] truncate">{@current_user.username}</span>
      </.link>
      <.link :if={assigns[:current_user]} href={~p"/users/log_out"} method="delete" class="hover:text-copper-strong">
        Log out
      </.link>
      <.link :if={!assigns[:current_user]} navigate={~p"/users/log_in"} class="hover:text-copper-strong">
        Log in
      </.link>
      <.link
        :if={!assigns[:current_user]}
        navigate={~p"/users/register"}
        class="rounded-full bg-amber-bg px-3 py-1 text-copper-strong hover:brightness-95"
      >
        Sign up
      </.link>
    </div>
  </div>
</header>
<main class="px-4 py-12 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl">
    <.flash_group flash={@flash} />

    <div
      :if={assigns[:current_user] && is_nil(@current_user.email)}
      class="mb-6 rounded-lg border border-amber bg-amber-bg px-4 py-3 text-sm text-copper-strong"
    >
      Add an email to your account so you can reset your password if you ever get locked out.
      <.link navigate={~p"/users/settings"} class="font-semibold underline">Add one now</.link>
    </div>

    {@inner_content}
  </div>
</main>
