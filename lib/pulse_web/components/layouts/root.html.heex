<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable]">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <%!-- For turning on alerts (assets/js/app.js); absent when alerts are switched off. --%>
    <meta :if={Pulse.Push.enabled?()} name="vapid-public-key" content={Pulse.Push.public_key()} />
    <.live_title default="Pulse" suffix=" · Pulse">
      {assigns[:page_title]}
    </.live_title>
    <meta name="description" content="Crowdsourced power, water and market price reports for Zambia." />
    <%!--
      Installable app: "Add to Home Screen" opens Pulse full-screen with
      its own icon (priv/static/manifest.json, priv/static/images/icon-*).
      iPhones also need this before they'll show alerts.

      manifest.json and favicon.ico are plain paths on purpose, not ~p:
      in production ~p points static files at their digested name
      (manifest-1e5e….json), and Plug.Static only serves the top-level
      names listed in PulseWeb.static_paths/0, so those would 404. Files
      inside images/ are fine either way.
    --%>
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" href={~p"/images/icon.svg"} type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href={~p"/images/apple-touch-icon.png"} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="apple-mobile-web-app-title" content="Pulse" />
    <script>
      // Apply a previously-chosen dark theme before the page paints, so
      // there's no flash of light mode for returning visitors. Light is
      // the default whenever nothing has been chosen yet.
      (function () {
        try {
          if (localStorage.getItem("pulse-theme") === "dark") {
            document.documentElement.setAttribute("data-theme", "dark");
          }
        } catch (_error) {}
      })();
    </script>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="bg-paper text-ink">
    <.page_flash flash={assigns[:flash] || %{}} />
    {@inner_content}
  </body>
</html>
